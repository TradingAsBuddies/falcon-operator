[Unit]
Description=Falcon Multi-Strategy Orchestrator - Continuous Trading Automation
After=network-online.target falcon-screener.service falcon-dashboard.service
Wants=network-online.target
Requires=falcon-dashboard.service

[Service]
Type=simple
User=falcon
Group=falcon

# Environment - paths can be overridden in EnvironmentFile
Environment="FALCON_HOME=/opt/falcon"
Environment="FALCON_PYTHON=/opt/falcon/venv/bin/python3"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONIOENCODING=utf-8"
Environment="LC_ALL=C.UTF-8"
Environment="FALCON_ENV=production"
EnvironmentFile=-/etc/falcon/falcon.env

# Start command using configured paths
ExecStart=/bin/bash -c '${FALCON_PYTHON} -u ${FALCON_HOME}/run_orchestrator.py'
WorkingDirectory=/opt/falcon

# Restart policy - always restart if it fails
Restart=always
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-orchestrator-daemon

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/falcon
ReadWritePaths=/var/lib/falcon
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits (prevent runaway resource usage)
MemoryMax=2G
CPUQuota=75%
TasksMax=100

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
