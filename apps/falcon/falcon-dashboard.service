[Unit]
Description=Falcon Trading Dashboard - Web Interface and API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=falcon
Group=falcon

# Environment - paths can be overridden in EnvironmentFile
Environment="FALCON_HOME=/opt/falcon"
Environment="FALCON_PYTHON=/opt/falcon/venv/bin/python3"
Environment="PYTHONUNBUFFERED=1"
Environment="FALCON_ENV=production"
EnvironmentFile=-/etc/falcon/falcon.env

# Start command using configured paths
ExecStart=/bin/bash -c '${FALCON_PYTHON} ${FALCON_HOME}/dashboard_server.py'
WorkingDirectory=/opt/falcon

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-dashboard

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/falcon
ReadWritePaths=/var/lib/falcon
ReadWritePaths=/var/log/falcon

# Resource limits
MemoryMax=512M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
