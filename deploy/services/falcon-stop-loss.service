[Unit]
Description=Falcon Stop-Loss Monitor
After=network-online.target falcon-dashboard.service
Wants=network-online.target
Requires=falcon-dashboard.service

[Service]
Type=simple
User=falcon
Group=falcon

# Environment - paths can be overridden in EnvironmentFile
Environment="FALCON_HOME=/opt/falcon"
Environment="FALCON_PYTHON=/opt/falcon/venv/bin/python3"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/falcon/falcon.env

# Start command using configured paths
ExecStart=/bin/bash -c '${FALCON_PYTHON} ${FALCON_HOME}/stop_loss_monitor.py'
WorkingDirectory=/opt/falcon

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-stop-loss

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/falcon
ReadWritePaths=/var/lib/falcon

# Resource limits
MemoryMax=256M
CPUQuota=15%

[Install]
WantedBy=multi-user.target
