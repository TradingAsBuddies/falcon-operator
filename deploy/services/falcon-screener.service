[Unit]
Description=Falcon AI Stock Screener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=falcon
Group=falcon

# Environment - paths can be overridden in EnvironmentFile
Environment="FALCON_HOME=/opt/falcon"
Environment="FALCON_PYTHON=/opt/falcon/venv/bin/python3"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONIOENCODING=utf-8"
Environment="LC_ALL=C.UTF-8"
EnvironmentFile=-/etc/falcon/falcon.env

# Start command using configured paths
ExecStart=/bin/bash -c '${FALCON_PYTHON} ${FALCON_HOME}/ai_stock_screener.py'
WorkingDirectory=/opt/falcon

# Restart policy
Restart=always
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-screener

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/falcon
ReadWritePaths=/var/lib/falcon

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
