# Falcon Service Configuration
# Copy this file to /etc/falcon/falcon.env and customize as needed

# Installation paths (defaults shown)
# FALCON_HOME=/opt/falcon
# FALCON_PYTHON=/opt/falcon/venv/bin/python3

# Alternative: Use system Python
# FALCON_PYTHON=/usr/bin/python3

# Alternative: Custom installation path
# FALCON_HOME=/home/myuser/falcon
# FALCON_PYTHON=/home/myuser/falcon/venv/bin/python3

# Environment
FALCON_ENV=production

# API Keys (required)
MASSIVE_API_KEY=your_polygon_api_key
CLAUDE_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key

# Finviz (optional)
FINVIZ_AUTH_KEY=your_finviz_elite_key
FINVIZ_SCREENER_URL=https://finviz.com/screener.ashx?your_filters

# Database configuration
DB_TYPE=sqlite
DB_PATH=/var/lib/falcon/paper_trading.db

# PostgreSQL (if DB_TYPE=postgresql)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=falcon
# DB_USER=falcon
# DB_PASSWORD=your_password

# Manual watchlist (comma-separated tickers)
# MANUAL_WATCHLIST=FEED,BAC,EVTV
