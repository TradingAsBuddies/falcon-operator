[Unit]
Description=Falcon Strategy Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=falcon
Group=falcon

# Environment - paths can be overridden in EnvironmentFile
Environment="FALCON_HOME=/opt/falcon"
Environment="FALCON_PYTHON=/opt/falcon/venv/bin/python3"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/etc/falcon/falcon.env

# Start command using configured paths
ExecStart=/bin/bash -c '${FALCON_PYTHON} ${FALCON_HOME}/strategy_orchestrator.py'
WorkingDirectory=/opt/falcon

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=falcon-strategy

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/falcon
ReadWritePaths=/var/lib/falcon

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
